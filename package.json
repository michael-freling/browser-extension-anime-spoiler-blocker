{
  "name": "@michael-freling/browser-extension-anime-spoiler-blocker",
  "displayName": "Anime Spoiler Blocker",
  "version": "0.3.0",
  "description": "The browser extension for blocking spoilers of anime.",
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build --target=chrome-mv3 && plasmo build --target=edge-mv3",
    "package": "plasmo package",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@plasmohq/messaging": "^0.7.2",
    "@plasmohq/storage": "^1.15.0",
    "hook": "link:@plasmohq/storage/hook",
    "plasmo": "0.90.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.7.1",
    "@jest/globals": "^30.5.2",
    "@swc/core": "^1.16.22",
    "@swc/jest": "^0.2.39",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/chrome": "0.3.7",
    "@types/jest": "^30.0.0",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jest": "^30.5.2",
    "jest-environment-jsdom": "^30.5.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2"
  },
  "manifest": {
    "key": "$CRX_PUBLIC_KEY",
    "web_accessible_resources": [
      {
        "resources": [
          "~assets/**/*"
        ],
        "matches": []
      }
    ]
  }
}
