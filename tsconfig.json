{
  "extends": "plasmo/templates/tsconfig.base",
  "exclude": [
    "node_modules"
  ],
  "include": [
    ".plasmo/index.d.ts",
    "jest.config.ts",
    "./**/*.ts",
    "./**/*.tsx"
  ],
  "compilerOptions": {
    "jsx": "react-jsx",
    // TypeScript 7 removed baseUrl and moduleResolution "node",
    // which Plasmo's base config still sets
    "moduleResolution": "bundler",
    // TypeScript 7 no longer includes all @types packages by default
    "types": [
      "chrome",
      "jest",
      "node"
    ],
    "paths": {
      "~*": [
        "./src/*"
      ]
    },
    "verbatimModuleSyntax": false
  }
}
